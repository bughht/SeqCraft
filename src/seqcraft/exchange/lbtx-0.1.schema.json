{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqcraft.org/schema/lbtx-0.1.schema.json",
  "title": "SeqCraft LogicBlock Tree Exchange Format 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "units", "opts", "definitions", "root"],
  "properties": {
    "schema": {"const": "seqcraft.logicblock"},
    "version": {"const": "0.1"},
    "units": {"const": "SI"},
    "opts": {"$ref": "#/$defs/opts"},
    "definitions": {"type": "object"},
    "root": {"$ref": "#/$defs/block"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"}}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"},
    "finiteNumber": {"type": "number"},
    "numberArray": {"type": "array", "items": {"$ref": "#/$defs/finiteNumber"}},
    "timeArray": {"type": "array", "items": {"$ref": "#/$defs/time"}},
    "opts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_b1_hz", "max_grad_hz_per_m", "max_slew_hz_per_m_per_s", "max_frequency_offset_hz", "rf_dead_time_s", "rf_ringdown_time_s", "adc_dead_time_s", "adc_raster_time_s", "rf_raster_time_s", "grad_raster_time_s", "block_duration_raster_s", "adc_samples_limit", "rf_samples_limit", "adc_samples_divisor", "trigger_identifier_supported", "gamma_hz_per_t", "b0_t"],
      "properties": {
        "max_b1_hz": {"$ref": "#/$defs/finiteNumber"},
        "max_grad_hz_per_m": {"$ref": "#/$defs/finiteNumber"},
        "max_slew_hz_per_m_per_s": {"$ref": "#/$defs/finiteNumber"},
        "max_frequency_offset_hz": {"$ref": "#/$defs/finiteNumber"},
        "rf_dead_time_s": {"$ref": "#/$defs/time"},
        "rf_ringdown_time_s": {"$ref": "#/$defs/time"},
        "adc_dead_time_s": {"$ref": "#/$defs/time"},
        "adc_raster_time_s": {"$ref": "#/$defs/time"},
        "rf_raster_time_s": {"$ref": "#/$defs/time"},
        "grad_raster_time_s": {"$ref": "#/$defs/time"},
        "block_duration_raster_s": {"$ref": "#/$defs/time"},
        "adc_samples_limit": {"type": "integer", "minimum": 0},
        "rf_samples_limit": {"type": "integer", "minimum": 0},
        "adc_samples_divisor": {"type": "integer", "minimum": 1},
        "trigger_identifier_supported": {"type": "boolean"},
        "gamma_hz_per_t": {"$ref": "#/$defs/finiteNumber"},
        "b0_t": {"$ref": "#/$defs/finiteNumber"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "nodes"],
      "properties": {
        "tag": {"type": "string"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_s", "item"],
            "properties": {
              "start_s": {"$ref": "#/$defs/time"},
              "item": {"oneOf": [{"$ref": "#/$defs/blockItem"}, {"$ref": "#/$defs/eventItem"}]}
            }
          }
        }
      }
    },
    "blockItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block"],
      "properties": {"kind": {"const": "block"}, "block": {"$ref": "#/$defs/block"}}
    },
    "eventItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_type", "payload"],
      "properties": {
        "kind": {"const": "event"},
        "event_type": {"enum": ["delay", "trap", "grad", "rf", "adc", "labelset", "labelinc", "trigger", "output", "seqcraft_barrier"]},
        "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"event_type": {"const": "delay"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/delay"}}}},
        {"if": {"properties": {"event_type": {"const": "trap"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/trap"}}}},
        {"if": {"properties": {"event_type": {"const": "grad"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/grad"}}}},
        {"if": {"properties": {"event_type": {"const": "rf"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/rf"}}}},
        {"if": {"properties": {"event_type": {"const": "adc"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/adc"}}}},
        {"if": {"properties": {"event_type": {"enum": ["labelset", "labelinc"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/label"}}}},
        {"if": {"properties": {"event_type": {"enum": ["trigger", "output"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/trigger"}}}},
        {"if": {"properties": {"event_type": {"const": "seqcraft_barrier"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/barrier"}}}}
      ]
    },
    "delay": {"type": "object", "additionalProperties": false, "required": ["duration_s"], "properties": {"duration_s": {"$ref": "#/$defs/time"}}},
    "trap": {"type": "object", "additionalProperties": false, "required": ["channel", "amplitude_hz_per_m", "rise_time_s", "flat_time_s", "fall_time_s", "area_per_m", "flat_area_per_m", "delay_s", "first_hz_per_m", "last_hz_per_m"], "properties": {"channel": {"enum": ["x", "y", "z"]}, "amplitude_hz_per_m": {"$ref": "#/$defs/finiteNumber"}, "rise_time_s": {"$ref": "#/$defs/time"}, "flat_time_s": {"$ref": "#/$defs/time"}, "fall_time_s": {"$ref": "#/$defs/time"}, "area_per_m": {"$ref": "#/$defs/finiteNumber"}, "flat_area_per_m": {"$ref": "#/$defs/finiteNumber"}, "delay_s": {"$ref": "#/$defs/time"}, "first_hz_per_m": {"$ref": "#/$defs/finiteNumber"}, "last_hz_per_m": {"$ref": "#/$defs/finiteNumber"}}},
    "grad": {"type": "object", "additionalProperties": false, "required": ["channel", "waveform_hz_per_m", "sample_times_s", "delay_s", "shape_duration_s", "area_per_m", "first_hz_per_m", "last_hz_per_m"], "properties": {"channel": {"enum": ["x", "y", "z"]}, "waveform_hz_per_m": {"$ref": "#/$defs/numberArray"}, "sample_times_s": {"$ref": "#/$defs/timeArray"}, "delay_s": {"$ref": "#/$defs/time"}, "shape_duration_s": {"$ref": "#/$defs/time"}, "area_per_m": {"$ref": "#/$defs/finiteNumber"}, "first_hz_per_m": {"$ref": "#/$defs/finiteNumber"}, "last_hz_per_m": {"$ref": "#/$defs/finiteNumber"}}},
    "rf": {"type": "object", "additionalProperties": false, "required": ["signal_hz", "sample_times_s", "shape_duration_s", "frequency_offset_hz", "phase_offset_rad", "frequency_offset_ppm", "phase_offset_ppm", "dead_time_s", "ringdown_time_s", "delay_s", "center_s", "use"], "properties": {"signal_hz": {"type": "object", "additionalProperties": false, "required": ["real", "imag"], "properties": {"real": {"$ref": "#/$defs/numberArray"}, "imag": {"$ref": "#/$defs/numberArray"}}}, "sample_times_s": {"$ref": "#/$defs/timeArray"}, "shape_duration_s": {"$ref": "#/$defs/time"}, "frequency_offset_hz": {"$ref": "#/$defs/finiteNumber"}, "phase_offset_rad": {"$ref": "#/$defs/finiteNumber"}, "frequency_offset_ppm": {"$ref": "#/$defs/finiteNumber"}, "phase_offset_ppm": {"$ref": "#/$defs/finiteNumber"}, "dead_time_s": {"$ref": "#/$defs/time"}, "ringdown_time_s": {"$ref": "#/$defs/time"}, "delay_s": {"$ref": "#/$defs/time"}, "center_s": {"$ref": "#/$defs/time"}, "use": {"type": ["string", "null"]}}},
    "adc": {"type": "object", "additionalProperties": false, "required": ["num_samples", "dwell_s", "delay_s", "frequency_offset_hz", "phase_offset_rad", "frequency_offset_ppm", "phase_offset_ppm", "dead_time_s", "phase_modulation_rad"], "properties": {"num_samples": {"type": "integer", "minimum": 1}, "dwell_s": {"$ref": "#/$defs/time"}, "delay_s": {"$ref": "#/$defs/time"}, "frequency_offset_hz": {"$ref": "#/$defs/finiteNumber"}, "phase_offset_rad": {"$ref": "#/$defs/finiteNumber"}, "frequency_offset_ppm": {"$ref": "#/$defs/finiteNumber"}, "phase_offset_ppm": {"$ref": "#/$defs/finiteNumber"}, "dead_time_s": {"$ref": "#/$defs/time"}, "phase_modulation_rad": {"$ref": "#/$defs/numberArray"}}},
    "label": {"type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": {"label": {"type": "string"}, "value": {"type": "integer"}}},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["channel", "delay_s", "duration_s"], "properties": {"channel": {"type": "string"}, "delay_s": {"$ref": "#/$defs/time"}, "duration_s": {"$ref": "#/$defs/time"}}},
    "barrier": {"type": "object", "additionalProperties": false, "required": ["tag"], "properties": {"tag": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"producer": {"type": "string"}, "producer_version": {"type": "string"}, "git_commit": {"type": "string"}, "metadata": {"type": "object"}}}
  }
}
